generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Currency {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  symbol String
  
}

model Plan {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  total_branch Int @default(0)
  price Float @default(0.0)


}
