generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Currency {
  id              String           @id @default(dbgenerated("gen_random_uuid()"))
  name            String
  symbol          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  treatmentPrices TreatmentPrice[]
  consults        Consult[]
  Plan            Plan[]

  @@map("currencies")
}

model Plan {
  id                  String        @id @default(dbgenerated("gen_random_uuid()"))
  name                String
  total_branch        Int?          @default(0)
  price               Float         @default(0.0)
  currencyId          String
  duration            Int           @default(30)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  isOnPromotion       Boolean       @default(false)
  promotionalPrice    Float?
  promotionEndDate    DateTime?
  promotionStartDate  DateTime?
  promotionPercentage Float?
  slug                String        @unique
  deletedAt           DateTime?
  Headquarter         Headquarter[]
  PlanBenefit         PlanBenefit[]
  currency            Currency      @relation(fields: [currencyId], references: [id])

  @@map("plans")
}

model Benefit {
  id          String        @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  details     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  PlanBenefit PlanBenefit[]

  @@map("benefits")
}

model PlanBenefit {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  planId    String
  benefitId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  benefit   Benefit   @relation(fields: [benefitId], references: [id])
  plan      Plan      @relation(fields: [planId], references: [id])

  @@unique([planId, benefitId])
  @@map("plan_benefits")
}

model Headquarter {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  address     String
  description String?
  nif         String
  logo        String?
  planId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  Branch      Branch[]
  plan        Plan      @relation(fields: [planId], references: [id])

  @@map("headquarters")
}

model Address {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  street    String
  city      String
  province  String?
  zipCode   String?
  country   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  Person    Person[]
  Branch    Branch[]
  User      User[]

  @@map("addresses")
}

model Branch {
  id              String           @id @default(dbgenerated("gen_random_uuid()"))
  name            String
  addressId       String
  headquarterId   String
  description     String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  Person          Person[]
  treatmentPrices TreatmentPrice[]
  address         Address          @relation(fields: [addressId], references: [id])
  headquarter     Headquarter      @relation(fields: [headquarterId], references: [id])
  products        Product[]
  sales           Sale[]
  UserBranch      UserBranch[]
  User            User[]

  @@map("branches")
}

model User {
  id               String           @id @default(dbgenerated("gen_random_uuid()"))
  email            String           @unique
  password         String
  username         String           @unique
  branchId         String
  addressId        String?
  roleId           String?
  isActive         Boolean          @default(false)
  phoneNumber      Int?
  countryCode      String?
  isPhoneVerified  Boolean          @default(false)
  isEmailVerified  Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  accessHistories  AccessHistory[]
  audits           Audit[]
  loginHistories   LoginHistory[]
  Person           Person[]
  Appointment      Appointment[]    @relation("UserPrimaryAppointments")
  appointments     Appointment[]    @relation("UserSecondaryAppointments")
  clinicProccesses ClinicProccess[]
  Consult          Consult[]
  diagnostics      Diagnostic[]
  UserBranch       UserBranch[]
  UserRole         UserRole[]
  Address          Address?         @relation(fields: [addressId], references: [id])
  branch           Branch           @relation(fields: [branchId], references: [id])
  Role             Role?            @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Person {
  id               String           @id @default(dbgenerated("gen_random_uuid()"))
  firstName        String
  lastName         String
  birthDate        DateTime?
  email            String?          @unique
  gender           Sex              @default(OTHER)
  branchId         String
  addressId        String
  userId           String?
  roleId           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  address          Address          @relation(fields: [addressId], references: [id])
  branch           Branch           @relation(fields: [branchId], references: [id])
  Role             Role?            @relation(fields: [roleId], references: [id])
  User             User?            @relation(fields: [userId], references: [id])
  Appointment      Appointment[]    @relation("PersonPrimaryAppointments")
  appointments     Appointment[]    @relation("PersonSecondaryAppointments")
  clinicProccesses ClinicProccess[]
  consults         Consult[]
  diagnostics      Diagnostic[]

  @@map("Persons")
}

model Role {
  id             String           @id @default(dbgenerated("gen_random_uuid()"))
  name           String           @unique
  description    String?
  slug           String           @unique
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  Person         Person[]
  RolePermission RolePermission[]
  UserRole       UserRole[]
  User           User[]

  @@map("roles")
}

model Permission {
  id             String           @id @default(dbgenerated("gen_random_uuid()"))
  name           String           @unique
  description    String?
  slug           String           @unique
  isSystem       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  RolePermission RolePermission[]

  @@map("permissions")
}

model UserBranch {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  branchId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  branch    Branch    @relation(fields: [branchId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, branchId])
  @@map("user_branches")
}

model RolePermission {
  id           String     @id @default(dbgenerated("gen_random_uuid()"))
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  roleId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  role      Role      @relation(fields: [roleId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Appointment {
  id          String            @id @default(dbgenerated("gen_random_uuid()"))
  date        DateTime
  time        DateTime
  reason      String
  description String?
  status      AppointmentStatus
  asAnswered  Boolean           @default(false)
  patientId   String
  doctorId    String
  personId    String?
  userId      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  doctor      User              @relation("UserPrimaryAppointments", fields: [doctorId], references: [id])
  patient     Person            @relation("PersonPrimaryAppointments", fields: [patientId], references: [id])
  Person      Person?           @relation("PersonSecondaryAppointments", fields: [personId], references: [id])
  user        User?             @relation("UserSecondaryAppointments", fields: [userId], references: [id])

  @@map("appointments")
}

model Consult {
  id                String             @id @default(dbgenerated("gen_random_uuid()"))
  patientId         String
  doctorId          String
  description       String?
  consultType       ConsultType        @default(CONSULT)
  amount            Float
  isPaid            Boolean            @default(false)
  paidAt            DateTime?
  paidAmount        Float?
  paidCurrencyId    String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  prescriptions     Prescription[]
  consultTreatments ConsultTreatment[]
  doctor            User               @relation(fields: [doctorId], references: [id])
  paidCurrency      Currency           @relation(fields: [paidCurrencyId], references: [id])
  patient           Person             @relation(fields: [patientId], references: [id])

  @@map("consults")
}

model ConsultTreatment {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  consultId   String
  treatmentId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  consult     Consult   @relation(fields: [consultId], references: [id])
  treatment   Treatment @relation(fields: [treatmentId], references: [id])

  @@unique([consultId, treatmentId])
  @@map("consult_treatments")
}

model Treatment {
  id                String             @id @default(dbgenerated("gen_random_uuid()"))
  name              String
  description       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  treatmentPrices   TreatmentPrice[]
  consultTreatments ConsultTreatment[]

  @@map("treatments")
}

model TreatmentPrice {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  branchId    String
  price       Float
  currencyId  String
  treatmentId String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  branch      Branch    @relation(fields: [branchId], references: [id])
  Currency    Currency  @relation(fields: [currencyId], references: [id])
  treatment   Treatment @relation(fields: [treatmentId], references: [id])
}

model Product {
  id                  String             @id @default(dbgenerated("gen_random_uuid()"))
  name                String
  brand               String?
  price               Float
  description         String?
  cover               String?
  stock               Int
  recommendedQuantity Int?
  branchId            String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  prescriptionItems   PrescriptionItem[]
  branch              Branch             @relation(fields: [branchId], references: [id])
  saleItems           SaleItem[]

  @@map("products")
}

model Sale {
  id                String        @id @default(dbgenerated("gen_random_uuid()"))
  clientName        String
  clientEmail       String?
  hasPrescription   Boolean       @default(false)
  prescriptionId    String?
  prescriptionPDF   String?
  isInternalPatient Boolean       @default(false)
  branchId          String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  saleItems         SaleItem[]
  branch            Branch        @relation(fields: [branchId], references: [id])
  prescription      Prescription? @relation(fields: [prescriptionId], references: [id])

  @@map("sales")
}

model SaleItem {
  id                           String    @id @default(dbgenerated("gen_random_uuid()"))
  saleId                       String
  productId                    String
  quantity                     Int
  unitPrice                    Float
  totalPrice                   Float
  discountPercentage           Float?
  ivaApplied                   Float?
  totalPriceWithDiscount       Float?
  totalPriceWithIva            Float?
  totalPriceWithDiscountAndIva Float?
  observation                  String?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  deletedAt                    DateTime?
  product                      Product   @relation(fields: [productId], references: [id])
  sale                         Sale      @relation(fields: [saleId], references: [id])

  @@map("sale_items")
}

model Prescription {
  id                String             @id @default(dbgenerated("gen_random_uuid()"))
  consultationId    String
  recommendations   String?
  duration          Int
  period            PrescriptionPeriod
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  consultation      Consult            @relation(fields: [consultationId], references: [id])
  prescriptionItems PrescriptionItem[]
  sales             Sale[]
}

model PrescriptionItem {
  id             String       @id @default(dbgenerated("gen_random_uuid()"))
  prescriptionId String
  productId      String
  quantity       Int
  details        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])

  @@map("prescription_items")
}

model ClinicProccess {
  id                 String    @id @default(dbgenerated("gen_random_uuid()"))
  name               String
  content            String
  patientId          String
  doctorId           String
  consultReason      String?
  alergicMedications String?
  tratamentPlan      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?
  doctor             User      @relation(fields: [doctorId], references: [id])
  person             Person    @relation(fields: [patientId], references: [id])

  @@map("clinic_proccesses")
}

model Diagnostic {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  designation String
  patientId   String
  doctorId    String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  doctor      User      @relation(fields: [doctorId], references: [id])
  patient     Person    @relation(fields: [patientId], references: [id])

  @@map("diagnostics")
}

model NewLatter {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  email     String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("new_latters")
}

model Message {
  id        String    @id @default(dbgenerated("gen_random_uuid()"))
  name      String
  email     String
  subject   String
  content   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("messages")
}

model Audit {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String?
  action    String
  details   String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User?    @relation(fields: [userId], references: [id])
}

model Log {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  level     String
  message   String
  meta      String?
  createdAt DateTime @default(now())
}

model LoginHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  ip        String?
  userAgent String?
  success   Boolean  @default(true)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

model AccessHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String
  route     String
  method    String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum TypeRole {
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PATIENT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  RESCHEDULED
}

enum ConsultType {
  CONSULT
  DIAGNOSTIC
  TREATMENT
  SURGERY
  OTHER
  CHECKUP
  EXAM
  ROUTINE
}

enum PrescriptionPeriod {
  DAILY
  MONTH
  YEAR
}
